# ---- DeansList (server-side only) ----
# Subdomain is the first part of your DeansList URL: https://<subdomain>.deanslistsoftware.com
DEANSLIST_SUBDOMAIN=kindleeducation
DEANSLIST_API_KEY=
# Optional: point at the local mock (npm run mock:deanslist) instead of the real API
# DEANSLIST_BASE_URL=http://localhost:4010/api

# ---- Database (Neon Postgres) ----
DATABASE_URL=

# ---- Scheduled jobs ----
# Cloud Scheduler sends "Authorization: Bearer <JOBS_SECRET>" to POST /api/jobs/<name>
JOBS_SECRET=
# true = log every Slack message and email instead of sending it (safe default)
DRY_RUN=true
# School time zone; "today" for every job is computed here
TZ_NAME=America/New_York
# A homeroom counts as submitted when this share of its enrolled students has a mark today
HOMEROOM_SUBMITTED_MIN_RATIO=0.5

# ---- Slack bot ----
# Scopes: chat:write, files:write, users:read, users:read.email, im:write. Invite the bot to the grade channels.
SLACK_BOT_TOKEN=

# ---- Gmail (service account with domain-wide delegation, scope gmail.send) ----
# base64 of the service account JSON key file:  base64 -w0 key.json
GOOGLE_SA_JSON_B64=
# The shared mailbox the app sends as (the service account impersonates it)
MAIL_FROM=attendance@kindleeducation.org

# ---- Admin sign-in (next-auth, Google) ----
AUTH_SECRET=            # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=kindleeducation.org
# Local development only (ignored in production and on Vercel): skip sign-in
# AUTH_DISABLED=true

# ---- Optional ----
# Public URL of the app, used in emails and Slack links
# APP_URL=https://attendance.kindleeducation.org
